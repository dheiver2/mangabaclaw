{
  "name": "@mangabaclaw/amazon-bedrock-provider",
  "version": "2026.8.1",
  "description": "MangabaClaw Amazon Bedrock provider plugin with model discovery, embeddings, and guardrail support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1095.0",
    "@aws-sdk/client-bedrock-runtime": "3.1095.0",
    "@aws-sdk/credential-provider-node": "3.972.72",
    "@smithy/node-http-handler": "4.9.11",
    "@smithy/shared-ini-file-loader": "4.6.14",
    "@smithy/types": "4.16.1"
  },
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*"
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@mangabaclaw/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
