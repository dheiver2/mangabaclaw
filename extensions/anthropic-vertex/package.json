{
  "name": "@mangabaclaw/anthropic-vertex-provider",
  "version": "2026.8.1",
  "description": "MangabaClaw Anthropic Vertex provider plugin for Claude models on Google Vertex AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "0.19.0",
    "google-auth-library": "10.9.1",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*"
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@mangabaclaw/anthropic-vertex-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
