{
  "name": "@mangabaclaw/deepinfra-provider",
  "version": "2026.8.1",
  "description": "MangabaClaw DeepInfra provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  },
  "type": "module",
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*"
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@mangabaclaw/deepinfra-provider",
      "npmSpec": "@mangabaclaw/deepinfra-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
