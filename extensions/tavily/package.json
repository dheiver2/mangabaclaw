{
  "name": "@mangabaclaw/tavily-plugin",
  "version": "2026.8.1",
  "description": "MangabaClaw Tavily plugin",
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*"
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@mangabaclaw/tavily-plugin",
      "npmSpec": "@mangabaclaw/tavily-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  }
}
