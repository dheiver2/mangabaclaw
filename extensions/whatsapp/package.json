{
  "name": "@mangabaclaw/whatsapp",
  "version": "2026.8.1",
  "description": "MangabaClaw WhatsApp channel plugin for WhatsApp Web chats.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  },
  "type": "module",
  "dependencies": {
    "audio-decode": "2.2.3",
    "baileys": "7.0.0-rc13",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*",
    "mangabaclaw": "workspace:*"
  },
  "peerDependencies": {
    "mangabaclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "mangabaclaw": {
      "optional": true
    }
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": true,
      "legacySessionSurfaces": true
    },
    "channel": {
      "id": "whatsapp",
      "approvalFlags": [
        "native"
      ],
      "label": "WhatsApp",
      "selectionLabel": "WhatsApp (QR link)",
      "detailLabel": "WhatsApp Web",
      "docsPath": "/channels/whatsapp",
      "docsLabel": "whatsapp",
      "blurb": "works with your own number; recommend a separate phone + eSIM.",
      "systemImage": "message",
      "persistedAuthState": {
        "specifier": "./auth-presence",
        "exportName": "hasAnyWhatsAppAuth"
      },
      "setup": {
        "fields": [
          {
            "key": "authDir",
            "kind": "string",
            "cli": {
              "flags": "--auth-dir <path>",
              "description": "WhatsApp auth directory override"
            }
          }
        ]
      }
    },
    "install": {
      "clawhubSpec": "clawhub:@mangabaclaw/whatsapp",
      "npmSpec": "@mangabaclaw/whatsapp",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
