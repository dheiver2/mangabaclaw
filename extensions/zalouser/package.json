{
  "name": "@mangabaclaw/zalouser",
  "version": "2026.8.1",
  "description": "MangabaClaw Zalo Personal Account plugin via native zca-js integration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mangabaclaw/mangabaclaw"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6",
    "zca-js": "2.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mangabaclaw/plugin-sdk": "workspace:*",
    "mangabaclaw": "workspace:*"
  },
  "peerDependencies": {
    "mangabaclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "mangabaclaw": {
      "optional": true
    }
  },
  "mangabaclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "zalouser",
      "configuredState": {
        "env": {
          "anyOf": [
            "ZALOUSER_PROFILE",
            "ZCA_PROFILE"
          ]
        }
      },
      "label": "Zalo Personal",
      "selectionLabel": "Zalo (Personal Account)",
      "docsPath": "/channels/zalouser",
      "docsLabel": "zalouser",
      "blurb": "Zalo personal account via QR code login.",
      "aliases": [
        "zlu"
      ],
      "order": 85,
      "quickstartAllowFrom": false,
      "doctorCapabilities": {
        "dmAllowFromMode": "topOnly",
        "groupModel": "hybrid",
        "groupAllowFromFallbackToAllowFrom": false,
        "warnOnEmptyGroupSenderAllowlist": false
      },
      "setup": {
        "fields": []
      }
    },
    "install": {
      "npmSpec": "@mangabaclaw/zalouser",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "mangabaclawVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
